# ==============================================================================
# FarmConnect Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
# In production, strict validation enforces secure SECRET_KEY, MOCK_OTP_ENABLED=False, and DATABASE_URL.
APP_ENV=development

# Flask Debug Mode: 1 for local development, 0 for production
FLASK_DEBUG=1

# Secret Key for cryptographic session signing and CSRF protection
# Generate a cryptographically secure token: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL Database Connection URL
# Local development format: postgresql://postgres:your_password@localhost:5432/farmconnect_db
# Hosted cloud database format (with SSL): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/farmconnect_db

# Mock OTP Configuration:
# - Allowed ONLY when APP_ENV is 'development' or 'testing'.
# - The application explicitly asserts and REJECTS startup if MOCK_OTP_ENABLED=True when APP_ENV=production.
MOCK_OTP_ENABLED=True

# Production SMS Gateway Configuration:
# Supported providers: fast2sms, twilio, msg91, aws_sns, generic
SMS_PROVIDER=generic
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=FRMCON

# Persistent Machinery Image Storage:
# - 'local': Saves to filesystem / persistent container volume (default)
# - 's3': Saves to S3-compatible cloud object storage (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces)
STORAGE_BACKEND=local
# S3_BUCKET_NAME=farmconnect-machinery-photos
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION_NAME=auto
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# S3_CUSTOM_DOMAIN=https://photos.farmconnect.example.com

# Production Server Listening Port
PORT=5000

