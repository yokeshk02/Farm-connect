# ==============================================================================
# FarmConnect Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your credentials.
# DO NOT commit .env to version control!
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
APP_ENV=development

# Flask Debug Mode: 1 for active debugging in development, 0 for production
FLASK_DEBUG=1

# Secret Key for session signing and CSRF protection
# Generate a strong key in production (e.g., using `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL Database Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/farmconnect_db

# Mock OTP Configuration:
# - Allowed ONLY when APP_ENV is 'development' or 'testing'.
# - The application explicitly asserts and REJECTS startup if MOCK_OTP_ENABLED=True when APP_ENV=production.
MOCK_OTP_ENABLED=True

# External SMS Gateway (Deferred to production deployment)
# SMS_PROVIDER=fast2sms
# SMS_API_KEY=your_sms_api_key_here
